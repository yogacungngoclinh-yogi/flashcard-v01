{
  "name": "english-kids-learning-core-prep",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Independent, dependency-free preparation package. Not yet integrated into the existing application.",
  "exports": "./src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
